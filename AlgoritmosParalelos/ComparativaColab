def _oe_chunk(arr, s, q0, q1):
    """Compara-intercambia los pares q0..q1-1 de la fase que empieza en s (0-indexado)."""
    lo, hi = s + 2 * q0, s + 2 * q1
    left, right = arr[lo:hi:2], arr[lo + 1:hi:2]
    mn, mx = np.minimum(left, right), np.maximum(left, right)   # if x_i > x_{i+1}: intercambiar
    arr[lo:hi:2] = mn
    arr[lo + 1:hi:2] = mx


def _oe_task(args):
    _oe_chunk(_arr, *args)


def odd_even_sequential(data):
    """Versión secuencial (1 proceso). Devuelve (resultado, segundos)."""
    a = data.copy()
    n = len(a)
    t0 = time.perf_counter()
    for _ in range(math.ceil(n / 2)):
        for s in (0, 1):                   # 0 = fase impar, 1 = fase par
            m = (n - s) // 2
            if m:
                _oe_chunk(a, s, 0, m)
    return a, time.perf_counter() - t0


def odd_even_parallel(data, p):
    """Versión paralela: en cada fase los pares se reparten entre p procesos. Devuelve (resultado, segundos)."""
    n = len(data)
    with shared_pool(data, p) as (arr, pool):
