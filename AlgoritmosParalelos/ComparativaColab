    return result, elapsed


# ============================================================================
# 2) MEZCLA-DIVISIÓN (merge-split) con N bloques
#    Se rellena con centinelas (max+1) hasta que n sea múltiplo de N, porque el algoritmo
#    supone bloques iguales de n/N; con bloques desiguales puede no ordenar bien.
# ============================================================================
def ms_sort_block(arr, a, b):
    arr[a:b].sort()                        # QUICKSORT(S_i) (introsort de numpy)


def ms_merge_pair(arr, a, m, b):
    """SEQUENTIAL MERGE(S_i, S_{i+1}, S') y división: S_i <- mitad menor, S_{i+1} <- mitad mayor."""
    merged = np.concatenate((arr[a:m], arr[m:b]))
    merged.sort(kind="stable")             # timsort: mezcla lineal de dos corridas ordenadas
    arr[a:b] = merged


def _ms_sort_task(bounds):
    ms_sort_block(_arr, *bounds)


def _ms_merge_task(bounds):
    ms_merge_pair(_arr, *bounds)


def _ms_prepare(data, N):
    pad = (-len(data)) % N
    padded = np.concatenate((data, np.full(pad, data.max() + 1, dtype=data.dtype)))
    edges = np.linspace(0, len(padded), N + 1).astype(int)
    blocks = [(int(edges[i]), int(edges[i + 1])) for i in range(N)]
    return padded, blocks


def _ms_subphases(blocks):
    """Genera, por subfase (impares y pares de cada ciclo), la lista de parejas (a, m, b) a mezclar."""
    N = len(blocks)
    for _ in range(math.ceil(N / 2)):
        for s in (0, 1):
            pairs = [(blocks[i][0], blocks[i][1], blocks[i + 1][1]) for i in range(s, N - 1, 2)]
            if pairs:
                yield pairs


def merge_split_sequential(data, N):
    """Versión secuencial: los N 'procesadores' se ejecutan uno tras otro en 1 proceso."""
    padded, blocks = _ms_prepare(data, N)
    t0 = time.perf_counter()
    for b in blocks:
        ms_sort_block(padded, *b)
    for pairs in _ms_subphases(blocks):
        for pr in pairs:
            ms_merge_pair(padded, *pr)
    return padded[:len(data)].copy(), time.perf_counter() - t0


def merge_split_parallel(data, N, p):
    """Versión paralela: bloques/parejas repartidos entre p procesos reales."""
    padded, blocks = _ms_prepare(data, N)
    with shared_pool(padded, p) as (arr, pool):
        t0 = time.perf_counter()
        pool.map(_ms_sort_task, blocks, chunksize=1)
        for pairs in _ms_subphases(blocks):
            pool.map(_ms_merge_task, pairs, chunksize=1)
        elapsed = time.perf_counter() - t0
        result = arr[:len(data)].copy()
        del arr
    return result, elapsed


