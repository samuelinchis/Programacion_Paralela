# ----------------------------------------------------------------------------
# Utilidades de memoria compartida + pool
# ----------------------------------------------------------------------------
_shm = None
_arr = None


def _init_worker(name, n, dtype_str):
    global _shm, _arr
    _shm = shared_memory.SharedMemory(name=name)
    _arr = np.ndarray((n,), dtype=np.dtype(dtype_str), buffer=_shm.buf)


def _noop(_):
    return 0


@contextmanager
def shared_pool(data, p):
    """Copia `data` a memoria compartida y crea un pool de p procesos que la ven. Cede (arr, pool)."""
    shm = shared_memory.SharedMemory(create=True, size=data.nbytes)
    arr = np.ndarray(data.shape, dtype=data.dtype, buffer=shm.buf)
    arr[:] = data
    pool = CTX.Pool(p, initializer=_init_worker, initargs=(shm.name, len(data), data.dtype.str))
    try:
        pool.map(_noop, range(p))          # calentamiento: los workers ya están listos
        yield arr, pool
    finally:
        pool.close()
        pool.join()
        del arr
        try:
            shm.close()
        except BufferError:
            pass
        shm.unlink()


