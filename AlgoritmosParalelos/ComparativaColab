# MODELOS TEÓRICOS (T en "operaciones"; solo importa la razón T_seq / T_par)
# ============================================================================
def T_odd_even(n, p):
    """n fases; en cada una, ~n/2 comparaciones repartidas entre p procesadores."""
    return n * math.ceil((n // 2) / p)


def T_merge_split(n, N, p):
    """Ordenamiento local de N bloques + N fases de N//2 mezclas de 2n/N elementos, sobre p procesadores."""
    m = n / N
    local = math.ceil(N / p) * m * math.log2(max(m, 2))
    merges = N * math.ceil((N // 2) / p) * 2 * m
    return local + merges


def T_bb(nodos_seq, p):
    """Ideal: los nodos se expanden en rondas de p vértices."""
    return math.ceil(nodos_seq / p)


# ============================================================================
# BENCHMARK  (cada algoritmo: secuencial vs paralelo del MISMO algoritmo)
# ============================================================================
def best_of(fn, repeats=REPEATS):
    best, out = math.inf, None
    for _ in range(repeats):
        t0 = time.perf_counter()
        out = fn()
        best = min(best, time.perf_counter() - t0)
    return best, out


def best_timed(fn, repeats=REPEATS):
    """fn devuelve (resultado, segundos). Devuelve (mejor tiempo, resultado)."""
    best, out = math.inf, None
    for _ in range(repeats):
        out, t = fn()
        best = min(best, t)
    return best, out


def fila(alg, tam, p, t_seq, t_par, T_seq, T_par):
    sp, sp_t = t_seq / t_par, T_seq / T_par
    t_teo = t_seq * T_par / T_seq          # tiempo paralelo predicho: t_seq medido x (T_par / T_seq)
    return {"algoritmo": alg, "tamaño": tam, "p": p,
            "t_seq (s)": t_seq, "t_par (s)": t_par,
            "speedup real": sp, "speedup teórico": sp_t, "eficiencia real": sp / p,
            "t_par teórico (s)": t_teo, "error %": 100 * (t_par - t_teo) / t_teo}


