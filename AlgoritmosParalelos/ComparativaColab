def show(df):
    try:
        from IPython.display import display
        display(df)
    except ImportError:
        print(df.to_string(index=False))


def graficar(df):
    import matplotlib.pyplot as plt
    etiquetas = df["algoritmo"].str.split(" ").str[0] + "\\n" + df["tamaño"]
    x = np.arange(len(df))
    fig, ax = plt.subplots(1, 2, figsize=(max(10, len(df) * 0.9), 4.5))
    ax[0].bar(x - 0.2, df["t_seq (s)"], 0.4, label="secuencial")
    ax[0].bar(x + 0.2, df["t_par (s)"], 0.4, label="paralelo")
    ax[0].set_yscale("log"); ax[0].set_ylabel("tiempo (s, escala log)"); ax[0].set_title("Tiempo real")
    ax[1].bar(x - 0.2, df["speedup real"], 0.4, label="real")
    ax[1].bar(x + 0.2, df["speedup teórico"], 0.4, label="teórico")
    ax[1].axhline(1, color="gray", ls="--", lw=1); ax[1].set_title("Speedup (>1 = el paralelo gana)")
    for a in ax:
        a.set_xticks(x); a.set_xticklabels(etiquetas, rotation=90, fontsize=7); a.legend()
    plt.tight_layout(); plt.show()


